# Copy to .env (never commit .env). All values below are placeholders.

# --- AI reader (any OpenAI-compatible endpoint). Leave the key empty to run fully offline with --mock.
OPENAI_API_KEY=
SLA_API_BASE_URL=https://api.groq.com/openai/v1
SLA_EXTRACTOR_MODEL=openai/gpt-oss-120b

# --- Free-tier pacing and caching for the AI reader
SLA_AI_MIN_INTERVAL=16
SLA_AI_CACHE=data/v2/ai_cache

# --- API service: JSON map of token -> {user, role, tenant}; roles: analyst | reviewer | admin
# SLA_API_TOKENS={"change-me": {"user": "alice", "role": "reviewer", "tenant": "demo"}}
# SLA_MODE=mock

# --- Business rules
SLA_APPROVAL_LIMIT_USD=5000
