{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{demo/**,core/**,agents/**,service/**,ui/users.py,ui/users.json,ui/seed_users.py,ui/__init__.py}",
      "excludeFiles": "{.venv/**,data/**,ledger/**,tests/**,docs/**,eval/**,data_gen/**,data_real/**,scripts/**,*.csv}"
    }
  }
}
